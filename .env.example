# GEMINI_API_KEY: Primary key for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Multi-Key Pool for Load-Balancing & Quota Protection (Optional):
# You can provide 4 separate Google AI Studio keys from different Google accounts.
# The server will round-robin across all 4 keys and auto-fallback if one hits quota limits.
# Either use comma-separated:
GEMINI_API_KEYS=""
# Or individual keys:
GEMINI_API_KEY_1=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
GEMINI_API_KEY_4=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MongoDB Connection URI (Optional: Uses resilient local JSON db if not provided)
MONGO_URI=""

# JWT secret for authentication
JWT_SECRET="careernav-stable-jwt-secret-2026-do-not-change"

# SMTP Configuration for verification and notification emails
SMTP_USER="kamaljit444501@gmail.com"
SMTP_PASS=""

# Optional frontend override for API base URL (defaults to current origin)
VITE_API_URL=""
